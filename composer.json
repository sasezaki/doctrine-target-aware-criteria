{
    "name": "otobank/doctrine-target-aware-criteria",
    "description": "Doctrine target aware criteria",
    "keywords": ["doctrine"],
    "license": "MIT",
    "authors": [
        {
            "name": "Toshiyuki Fujita",
            "email": "tfujita@otobank.co.jp"
        }
    ],
    "require": {
        "php": "^7.4 || ^8",
        "doctrine/collections": "^1.8 || ^2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93.1",
        "phpunit/phpunit": "^9.6.34",
        "phpstan/phpstan": "^1.12 || ^2",
        "phpstan/phpstan-phpunit": "^1.4.2 || ^2"
    },
    "autoload": {
        "psr-4": {
            "Otobank\\Doctrine\\Collections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Otobank\\Doctrine\\Collections\\": "tests/",
            "FakeApp\\": "tests/fake-app/"
        }
    },
    "scripts": {
        "qa": [
            "@test",
            "@cs"
        ],
        "test" : [
            "phpunit"
        ],
        "cs": [
            "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix -v --dry-run --diff"
        ],
        "cs-fix": [
            "php-cs-fixer fix -v"
        ]
    }
}
